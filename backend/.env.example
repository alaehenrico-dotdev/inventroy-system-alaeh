# Copy this file to .env and fill in real values for your machine.
# .env is gitignored and must never be committed - .env.example (this
# file) is the template that's safe to commit instead.

# Database credentials - defaults below match a stock XAMPP/local MySQL install.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_system
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Port the Express server listens on.
PORT=4000

# Used once by `npm run seed:admin` to create the initial admin login.
# Change these before running it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
